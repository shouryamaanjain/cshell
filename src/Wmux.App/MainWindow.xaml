<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Wmux.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="wmux">

    <Grid x:Name="RootGrid"
          Background="{StaticResource TerminalBackgroundBrush}"
          IsTabStop="True"
          KeyDown="OnRootKeyDown"
          CharacterReceived="OnRootCharReceived">

        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="220" MinWidth="186" MaxWidth="333"/>
            <ColumnDefinition Width="1"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Grid Grid.Column="0" Background="{StaticResource SidebarBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="12,0">
                <TextBlock Text="wmux"
                           VerticalAlignment="Center"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SidebarDimForeground}"/>
            </Grid>

            <Button Grid.Row="1"
                    Content="+ New Workspace"
                    Click="OnNewWorkspace"
                    HorizontalAlignment="Stretch"
                    Margin="8,4"
                    Padding="8,6"
                    FontSize="12"
                    Background="Transparent"
                    BorderBrush="{StaticResource DividerBrush}"
                    Foreground="{StaticResource SidebarDimForeground}"/>

            <ListView Grid.Row="2"
                      x:Name="WorkspaceList"
                      Margin="0,4,0,0"
                      Padding="4,0"
                      SelectionMode="Single"
                      SelectionChanged="OnWorkspaceSelected"
                      Background="Transparent">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="Margin" Value="0,1"/>
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid Padding="6,8" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0"
                                    CornerRadius="1.5"
                                    Background="{StaticResource AccentBrush}"/>

                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="12.5"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SidebarTitleForeground}"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding WorkingDirectory}"
                                           FontSize="10"
                                           Foreground="{StaticResource SidebarDimForeground}"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <Ellipse Grid.Column="2"
                                     Width="8" Height="8"
                                     Fill="{StaticResource AccentBrush}"
                                     VerticalAlignment="Center"
                                     Visibility="{Binding HasUnread, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="3" Padding="8,4">
                <Border Height="1" Background="{StaticResource DividerBrush}"/>
            </StackPanel>
        </Grid>

        <!-- Divider -->
        <Border Grid.Column="1" Background="{StaticResource DividerBrush}"/>

        <!-- Terminal content area — all canvases live here, visibility-toggled -->
        <Grid Grid.Column="2" x:Name="TerminalHost" Background="{StaticResource TerminalBackgroundBrush}"/>
    </Grid>
</Window>
